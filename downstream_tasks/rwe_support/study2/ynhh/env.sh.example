#!/bin/bash
# env.sh -- single source of truth for the site-specific paths of this module. Copy to env.sh
# and fill in the values; every stage script sources it. Each value is ${VAR:-...}, so a one-off
# override (RECLAIM_S_CKPT=... sbatch ...) still works without editing the file.
# ABSOLUTE paths only: a tilde does not expand inside double quotes.

# ReClaim checkpoints: exactly three sizes. The model key (reclaim-s | reclaim-m | reclaim-l)
# resolves to the variable of the same size, names the embeddings parquet
# (intermediate/embeddings/<cell>/cohort_with_<key>_embeddings.parquet) and the results spec
# dir (<key>-only). The checkpoints must match the token store's vocabulary (DATA_VERSION below):
# a vocabulary mismatch does not crash, it silently degrades every rep_* column.
export RECLAIM_S_CKPT="${RECLAIM_S_CKPT:-/path/to/CHANGE_ME}"
export RECLAIM_M_CKPT="${RECLAIM_M_CKPT:-/path/to/CHANGE_ME}"
export RECLAIM_L_CKPT="${RECLAIM_L_CKPT:-/path/to/CHANGE_ME}"

# Token store root (<DATA_VERSION>/ynhh_full beneath)
export PROCESSED_ROOT="${PROCESSED_ROOT:-/path/to/CHANGE_ME}"
# Version label of the processed token store (the subdirectory of the token-store root). It must
# match the tokens the ReClaim checkpoints were trained on: a mismatch does not crash, it silently
# degrades every rep_* column.
export DATA_VERSION="${DATA_VERSION:-CHANGE_ME}"

# CRAN mirror for utils.R ensure_packages and the repo-level install_r_packages.R. The YNHH
# cluster has no public egress; point this at its local Posit/CRAN mirror.
export CRAN_REPO="${CRAN_REPO:-/path/to/CHANGE_ME}"

export RECLAIM_ENV="${RECLAIM_ENV:-/path/to/CHANGE_ME}"          # conda env NAME (or absolute path)
export YNHH_OMOP_ROOT="${YNHH_OMOP_ROOT:-/path/to/CHANGE_ME}"    # OMOP parquet root (datasources/registry.py)

# Preflight (informational; the consuming scripts decide hard-fail vs soft-skip).
for _v in RECLAIM_S_CKPT RECLAIM_M_CKPT RECLAIM_L_CKPT PROCESSED_ROOT; do
  [ -e "${!_v}" ] || echo "env.sh WARN: path does not exist (on this host): $_v=${!_v}"
done

#!/bin/bash
# env.sh -- checkpoint and data-root registration, sourced by every stage wrapper.
# Copy to env.sh and fill in the paths. Every value is ${VAR:-default}, so a one-off
# command-line override (RECLAIM_S_CKPT=... sbatch ...) still wins.
#
# Three ReClaim checkpoints, one per size. The key reclaim-<size> (reclaim-s, reclaim-m,
# reclaim-l) resolves to RECLAIM_<SIZE>_CKPT and names both the embedding parquet
# (intermediate/embeddings/cohort_with_<key>_embeddings.parquet) and the results spec dir
# (results/<comparison>/<key>-only/).
# The checkpoint vocabulary must match the token store: a mismatch does not crash, it
# silently degrades every rep_* column.
export RECLAIM_S_CKPT="${RECLAIM_S_CKPT:-/path/to/CHANGE_ME}"
export RECLAIM_M_CKPT="${RECLAIM_M_CKPT:-/path/to/CHANGE_ME}"
export RECLAIM_L_CKPT="${RECLAIM_L_CKPT:-/path/to/CHANGE_ME}"

# ---- Data roots ---------------------------------------------------------------
export RECLAIM_ENV="${RECLAIM_ENV:-/path/to/CHANGE_ME}"               # conda env (python, R, Spark)
export MS_RAW_SUBSET="${MS_RAW_SUBSET:-/path/to/CHANGE_ME}"           # raw claims root (MarketScan_val, MarketScan_test)
export MS_PROCESSED_ROOT="${MS_PROCESSED_ROOT:-/path/to/CHANGE_ME}"   # token-store root (<DATA_VERSION>/marketscan_{val,test})
# Version label of the processed token store (the subdirectory of the token-store root). It must
# match the tokens the ReClaim checkpoints were trained on: a mismatch does not crash, it silently
# degrades every rep_* column.
export DATA_VERSION="${DATA_VERSION:-CHANGE_ME}"
export VOCAB_NDC="${VOCAB_NDC:-/path/to/CHANGE_ME}"                   # NDC -> RxNorm ingredient map (csv)

# Preflight (informational; the consuming scripts decide hard-fail vs soft-skip).
for _v in RECLAIM_S_CKPT RECLAIM_M_CKPT RECLAIM_L_CKPT; do
  [ -e "${!_v}" ] || echo "env.sh WARN: path does not exist (on this host): $_v=${!_v}"
done

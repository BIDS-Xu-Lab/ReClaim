#!/bin/bash
# env.sh -- single source of truth for checkpoint and data paths. Copy to env.sh and fill in.
# Sourced by every bN_* wrapper. Every value is ${VAR:-default}, so a one-off override
# (RECLAIM_S_CKPT=... sbatch ...) still wins without editing this file.
#
# ReClaim checkpoints: exactly three sizes, registered as RECLAIM_S_CKPT / RECLAIM_M_CKPT /
# RECLAIM_L_CKPT and addressed by the keys reclaim-s / reclaim-m / reclaim-l. The key names the
# embedding parquet (cohort_with_<key>_embeddings.parquet) and the results spec dir (<key>-only).
# b2_1_embeddings resolves a key to the var of the same name (reclaim-l -> RECLAIM_L_CKPT).

# The checkpoints must match the token store's vocabulary (DATA_VERSION below).
export RECLAIM_S_CKPT="${RECLAIM_S_CKPT:-/path/to/CHANGE_ME}"
export RECLAIM_M_CKPT="${RECLAIM_M_CKPT:-/path/to/CHANGE_ME}"
export RECLAIM_L_CKPT="${RECLAIM_L_CKPT:-/path/to/CHANGE_ME}"

# Delphi (12L/120d, vocab 1269), run under the tag `delphi`.
export DELPHI_CKPT="${DELPHI_CKPT:-/path/to/CHANGE_ME}"
export DELPHI_MAP="${DELPHI_MAP:-/path/to/CHANGE_ME}"   # nature_disease_map.csv

# ---- Environment and data roots ---------------------------------------------------------
export RECLAIM_ENV="${RECLAIM_ENV:-/path/to/CHANGE_ME}"            # conda env (Python 3.11 + R)
export MS_RAW_FULL="${MS_RAW_FULL:-/path/to/CHANGE_ME}"            # full MarketScan claims tree
export MS_PROCESSED_ROOT="${MS_PROCESSED_ROOT:-/path/to/CHANGE_ME}" # ReClaim token store root
# Version label of the processed token store (the subdirectory of the token-store root). It must
# match the tokens the ReClaim checkpoints were trained on: a mismatch does not crash, it silently
# degrades every rep_* column.
export DATA_VERSION="${DATA_VERSION:-CHANGE_ME}"
# Token-store run folder of the full MarketScan tokenization, as written by preprocessing/pipeline_marketscan
# ($MS_PROCESSED_ROOT/$DATA_VERSION/$MS_RUN_NAME). Cohort membership is gated on it (b0_2) and the
# pre-index sequences are read from it (b2_1).
export MS_RUN_NAME="${MS_RUN_NAME:-CHANGE_ME}"
export VOCAB_NDC="${VOCAB_NDC:-/path/to/CHANGE_ME}"                # NDC -> RxNorm ingredient csv
export REDBOOK_CSV="${REDBOOK_CSV:-/path/to/CHANGE_ME}"            # Redbook NDC dictionary csv

# Preflight (informational; the consuming scripts decide hard-fail vs soft-skip).
for _v in $(compgen -A variable | grep '^\(RECLAIM\|DELPHI\)_.*_CKPT$') DELPHI_CKPT DELPHI_MAP; do
  [ -e "${!_v}" ] || echo "env.sh WARN: path does not exist (on this host): $_v=${!_v}"
done

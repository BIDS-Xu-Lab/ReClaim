#!/bin/bash
# env.sh -- site configuration: checkpoints, data roots, software. Copy to env.sh and fill in.
# Sourced by every wrapper and launcher. Every value is ${VAR:-default}, so a one-off override
# (RECLAIM_S_CKPT=... sbatch ...) still wins without editing this file. Pipeline constants
# (cohort rules, recipes, cutoffs) are not site-specific and live in config.sh.

# ReClaim pre-trained checkpoints: exactly three sizes, addressed as reclaim-s / reclaim-m / reclaim-l.
export RECLAIM_S_CKPT="${RECLAIM_S_CKPT:-/path/to/CHANGE_ME}"
export RECLAIM_M_CKPT="${RECLAIM_M_CKPT:-/path/to/CHANGE_ME}"
export RECLAIM_L_CKPT="${RECLAIM_L_CKPT:-/path/to/CHANGE_ME}"

# Tokenized MarketScan corpus the checkpoints were trained on:
#   <DATA_ROOT>/final_data/train       pre-training corpus (supervision pool for baselines and post-training)
#   <DATA_ROOT>/final_data/test        held-out evaluation cohort
#   <DATA_ROOT>/processed_data/vocab   token vocabulary
export DATA_ROOT="${DATA_ROOT:-/path/to/CHANGE_ME}"
# Raw MarketScan claims tree; only the discretization audit (TASK=discretization) reads it.
export MS_RAW_DIR="${MS_RAW_DIR:-}"

# Software
export CONDA_ENV="${CONDA_ENV:-reclaim-expenditure}"              # environment.yml
export CONDA_PYTHON="${CONDA_PYTHON:-/path/to/CHANGE_ME/bin/python}"
export MODULES="${MODULES:-}"          # modules every job loads, e.g. "miniconda" (empty = none)
export GPU_MODULES="${GPU_MODULES:-}"  # extra modules for GPU jobs, e.g. "CUDA/12.8.0 GCC/12.2.0"
export GPU_TYPE="${GPU_TYPE:-}"        # typed GPU request for the launchers (gres type); empty = any GPU

export COST_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"   # repository root
. "${COST_HOME}/config.sh"

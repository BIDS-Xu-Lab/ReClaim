#!/bin/bash
# env.sh -- single source of truth for cluster paths. Copy to env.sh (gitignored) and fill in.
# Sourced by pipeline_marketscan/run_marketscan.sh and pipeline_omop/<source>/run_<source>.sh. Every value is ${VAR:-default},
# so a one-off override (MS_RUN_NAME=... sbatch ...) still wins without editing this file.

_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ---- Software ---------------------------------------------------------------------------
export RECLAIM_ENV="${RECLAIM_ENV:-/path/to/CHANGE_ME}"   # conda env created from environment.yml
export SPARK_MODULE="${SPARK_MODULE:-Spark/3.5.4-foss-2022b-Scala-2.13}"   # cluster module providing spark-start

# ---- Inputs (licensed, never distributed) -----------------------------------------------
# Raw MarketScan Parquet tree with one folder per payer: CCAE/, MDCR/, MDCD/
# (files CCAE_T2018.snappy.parquet, ..., Medicaid_t2018.snappy.parquet, ...).
export MS_RAW_DIR="${MS_RAW_DIR:-/path/to/CHANGE_ME}"
# MarketScan dictionary folder (MSN_LOOKUP); s3 reads PLANTYP.csv and EGEOLOC.csv from it.
export MS_DICTIONARY_DIR="${MS_DICTIONARY_DIR:-/path/to/CHANGE_ME}"
# EHRSHOT OMOP CDM Parquet folder (person, payer_plan_period, visit_occurrence, condition_occurrence,
# procedure_occurrence, drug_exposure, concept, ...), one sub-folder per table.
export EHRSHOT_OMOP_DIR="${EHRSHOT_OMOP_DIR:-/path/to/CHANGE_ME}"
# YNHH OMOP CDM Parquet folder (same tables; lower-case columns, date_of_birth, *_datetime timestamps).
export YNHH_OMOP_DIR="${YNHH_OMOP_DIR:-/path/to/CHANGE_ME}"
# Vocabulary mappings produced by vocab_mapping/create_mappings.sh.
export VOCAB_MAPPING_DIR="${VOCAB_MAPPING_DIR:-$_ENV_DIR/vocab_mapping/mapping}"

# ---- Outputs ----------------------------------------------------------------------------
# Token store root. Each run writes to $MS_PROCESSED_ROOT/$DATA_VERSION/<run name>/.
export MS_PROCESSED_ROOT="${MS_PROCESSED_ROOT:-/path/to/CHANGE_ME}"
# Version label of the token store (a sub-directory name). Downstream training and evaluation
# code reads the same label, so keep it identical across repositories.
export DATA_VERSION="${DATA_VERSION:-CHANGE_ME}"
export MS_RUN_NAME="${MS_RUN_NAME:-marketscan_full}"       # MarketScan run folder
export EHRSHOT_RUN_NAME="${EHRSHOT_RUN_NAME:-ehrshot}"       # EHRSHOT run folder
export YNHH_FULL_RUN_NAME="${YNHH_FULL_RUN_NAME:-ynhh_full}"     # YNHH, all eligible patients
export YNHH_SUBSET_RUN_NAME="${YNHH_SUBSET_RUN_NAME:-ynhh_subset}" # YNHH, sampled cohort
